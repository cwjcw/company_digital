      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const expectedMode = 'production';\nconst item = $input.first().json;\nif (Number(item.code) !== 0) throw new Error('设备日报SSH非零退出，请检查该节点stderr');\nconst lines = String(item.stdout || '').trim().split(/\\r?\\n/).filter(Boolean);\nlet result;\ntry { result = JSON.parse(lines[lines.length - 1]); } catch { throw new Error('设备日报未返回有效JSON'); }\nif (result.mode !== expectedMode || result.recipientCount !== 9) throw new Error('设备日报模式或正式人数不符');\nif (expectedMode === 'production') {\n  const expected = ['text', 'operation_image', ...(result.reportingImageSent ? ['reporting_image'] : [])];\n  if (result.sent !== true || JSON.stringify(result.sequence) !== JSON.stringify(expected)) throw new Error('设备日报没有完成规定发送顺序');\n} else if (result.ready !== true || result.sent !== false) throw new Error('设备日报预检失败或发生了非预期发送');\nreturn [{json: result}];"
      },
      "onError": "continueErrorOutput"
    },
