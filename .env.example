COMPOSE_PROJECT_NAME=kdos
POSTGRES_IMAGE=postgres:18
WEB_BIND_ADDRESS=127.0.0.1
WEB_LAN_ADDRESS=192.168.1.249
WEB_ZEROTIER_ADDRESS=10.147.20.200
WEB_PORT=15172

NODE_ENV=production
API_PORT=15173
WEB_ORIGIN=http://localhost:15172,http://127.0.0.1:15172,http://192.168.1.249:15172,http://10.147.20.200:15172,https://knplan.cuixiaoyuan.cn
DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_USER=knplan
DATABASE_PASSWORD=replace_me
DATABASE_NAME=four_department_tracker
KDOS_DATABASE_HOST=postgres
KDOS_DATABASE_PORT=5432
KDOS_DATABASE_USER=knplan
KDOS_DATABASE_PASSWORD=replace_me
KDOS_DATABASE_NAME=kdos
KDOS_DATABASE_POOL_MAX=10
KDOS_DEFAULT_TENANT_CODE=KAINAN
JWT_ACCESS_SECRET=replace_with_at_least_32_random_characters
JWT_REFRESH_SECRET=replace_with_another_32_random_characters
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
ADMIN_USERNAME=admin
ADMIN_DISPLAY_NAME=系统管理员
ADMIN_INITIAL_PASSWORD=
UPLOAD_DIR=/app/data/uploads
MAX_IMAGE_BYTES=3145728
# 可选：企业加密软件的本地解密 CLI。{input} 与 {output} 会被安全替换为临时路径。
EXCEL_DECRYPT_COMMAND=
EXCEL_DECRYPT_ARGUMENTS=--input "{input}" --output "{output}"

# 畅捷通 T+ 双账套订单同步（真实密码和 API Key 只写入 .env）
TPLUS_SQL_HOST=127.0.0.1
TPLUS_SQL_PORT=14330
TPLUS_SQL_USER=replace_me
TPLUS_SQL_PASSWORD=replace_me
TPLUS_SQL_DATABASE=master
TPLUS_SQL_FILE=/data/automation/code/sql/TplusSQL/50_双账套有效订单统一报表.sql
TPLUS_BEGIN_DATE=2026-01-01
KNPLAN_API_URL=http://127.0.0.1:15172/api/v1
KNPLAN_TPLUS_API_KEY=replace_with_linked_user_api_key
