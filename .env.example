COMPOSE_PROJECT_NAME=knplan
POSTGRES_IMAGE=postgres:18
WEB_BIND_ADDRESS=127.0.0.1
WEB_LAN_ADDRESS=192.168.1.249
WEB_PORT=15172

NODE_ENV=production
API_PORT=15173
WEB_ORIGIN=http://localhost:15172,http://127.0.0.1:15172,http://192.168.1.249:15172,https://knplan.cuixiaoyuan.cn
DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_USER=knplan
DATABASE_PASSWORD=replace_me
DATABASE_NAME=four_department_tracker
JWT_ACCESS_SECRET=replace_with_at_least_32_random_characters
JWT_REFRESH_SECRET=replace_with_another_32_random_characters
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
ADMIN_USERNAME=admin
ADMIN_DISPLAY_NAME=系统管理员
ADMIN_INITIAL_PASSWORD=
UPLOAD_DIR=/app/data/uploads
MAX_IMAGE_BYTES=3145728
# 可选：企业加密软件的本地解密 CLI。{input} 与 {output} 会被安全替换为临时路径。
EXCEL_DECRYPT_COMMAND=
EXCEL_DECRYPT_ARGUMENTS=--input "{input}" --output "{output}"
