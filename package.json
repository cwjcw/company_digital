{
  "name": "four-department-tracker",
  "private": true,
  "packageManager": "pnpm@11.20.0",
  "scripts": {
    "dev": "pnpm --parallel --filter @tracker/api --filter @tracker/web dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:e2e": "pnpm --filter @tracker/web test:e2e",
    "db:migrate": "pnpm --filter @tracker/api db:migrate",
    "db:revert": "pnpm --filter @tracker/api db:revert",
    "db:seed": "pnpm --filter @tracker/api db:seed"
  },
  "devDependencies": {
    "concurrently": "^9.2.0"
  }
}
