{
  "name": "kainan-digital-os",
  "private": true,
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @tracker/api --filter @tracker/web dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:e2e": "pnpm --filter @tracker/web test:e2e",
    "sync:tplus": "node data-operations/tplus/sync.mjs",
    "sync:tplus:dry-run": "node data-operations/tplus/sync.mjs --dry-run",
    "test:tplus-sync": "node --test data-operations/tplus/*.test.mjs",
    "db:migrate": "pnpm --filter @tracker/api db:migrate",
    "db:revert": "pnpm --filter @tracker/api db:revert",
    "db:seed": "pnpm --filter @tracker/api db:seed",
    "db:kdos:create": "./scripts/init-kdos-db.sh",
    "db:kdos:migrate": "node scripts/migrate-kdos.mjs"
  },
  "devDependencies": {
    "concurrently": "^9.2.0",
    "dotenv": "^17.4.2",
    "mssql": "^12.7.0",
    "pg": "^8.16.3"
  }
}
