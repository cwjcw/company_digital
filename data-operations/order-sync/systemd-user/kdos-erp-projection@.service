[Unit]
Description=KDOS ERP formal table projection (%i)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/data/automation/code/work/PMC/knweb
ExecStart=/usr/bin/flock -n /tmp/kdos-erp-projection-%i.lock /data/automation/code/work/basci/basic_code/.venv/bin/python data-operations/order-sync/project.py --consumer %i
Nice=10

[Install]
WantedBy=default.target
